# Copia este archivo a .env (o configura las variables en Render). No subas .env al repositorio.

# Puerto del servidor
PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (docker-compose la sobrescribe para el servicio web)
DATABASE_URL=postgres://rodando:rodando@localhost:5432/rodando
# SSL a Postgres: por defecto true solo en producción. Pon false si tu Postgres no usa SSL.
# DATABASE_SSL=false

# Secreto para firmar los JWT (OBLIGATORIO en producción). Genera uno: openssl rand -hex 32
JWT_SECRET=cambia-esto
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma. Vacío = solo mismo origen.
ALLOWED_ORIGINS=

# Notificaciones push (opcional). Genera llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@rodandoutp.mx

# Contraseña de las cuentas de demo del seed (admin y conductores de ejemplo)
SEED_PASSWORD=Demo1234!
# SKIP_SEED=true   # no cargar datos de ejemplo al arrancar
